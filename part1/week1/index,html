<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>深度学习 第一篇</title>
    <style>
        body {
            background-color: darkblue;
            color: white;
            max-width: 820px;
            margin: 40px auto;
            padding: 0 20px;
            line-height: 1.8;
            font-family: "Segoe UI", "Microsoft YaHei", sans-serif;
        }
        h1, h2, h3 { border-bottom: 2px solid #66b3ff; padding-bottom: 8px; color: #fff; }
        code { background: #1a4d80; padding: 2px 6px; border-radius: 4px; color: #8ecbff; }
        pre { background: #0b2545; padding: 16px; border-radius: 8px; overflow-x: auto; }
        pre code { background: none; padding: 0; }
        blockquote { border-left: 4px solid #66b3ff; margin-left: 0; padding-left: 16px; color: #c3d9f0; }
        a { color: #66ccff; }
        img { max-width: 100%; }
    </style>
</head>
<body>
    <div id="content">加载中…</div>

    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <script>
        fetch('week1.md')
            .then(r => { if (!r.ok) throw new Error('HTTP ' + r.status); return r.text(); })
            .then(md => { document.getElementById('content').innerHTML = marked.parse(md); })
            .catch(e => { document.getElementById('content').textContent = '加载失败: ' + e; });
    </script>
</body>